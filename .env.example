# ── Database ──────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_root_password
DB_USER=adssu
DB_PASSWORD=change_db_password
DB_NAME=adssu_scheduling

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret

# ── CORS (comma-separated list of allowed origins) ───────────────────────────
# In production, set this to your actual domain e.g. https://scheduling.adssu.edu.ph
ALLOWED_ORIGINS=http://localhost:5000

# ── OR-Tools scheduling microservice ──────────────────────────────────────────
# URL of the Python FastAPI service in or-tools-service/. In docker-compose this
# is set automatically to http://or-tools:8001 — only needed here if running
# outside docker-compose (e.g. as separate Dokploy applications).
OR_TOOLS_SERVICE_URL=http://localhost:8001

# ── Hostinger SMTP (for OTP / Change Password emails) ────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@adssuccis26.com
SMTP_PASS=YOUR_EMAIL_PASSWORD_HERE
SMTP_FROM="ADSSU Room Scheduling <admin@adssuccis26.com>"
