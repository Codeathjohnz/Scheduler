# Dependencies
node_modules/
__pycache__/
*.pyc

# Environment secrets — never commit real credentials
.env
.env.local
.env.*.local
server/.env

# Build output (regenerated via `npm run build`)
client/dist
client/dist-ssr
server/public/

# Real institutional documents (not app assets) accidentally saved into
