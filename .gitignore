client/public/*.docx
client/public/*.doc
client/public/*.pdf
client/public/*.xlsx
client/public/*.xls

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

